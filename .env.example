# Copy to .env. All settings use the AGENTEVAL_ prefix (see agenteval/config.py).
AGENTEVAL_DATABASE_URL=postgresql+asyncpg://agenteval:agenteval@localhost:5433/agenteval
AGENTEVAL_REDIS_URL=redis://localhost:6379/0

# "anthropic" calls Claude; "fake" runs a canned offline demo.
AGENTEVAL_LLM_PROVIDER=anthropic
AGENTEVAL_LLM_MODEL=claude-opus-5
AGENTEVAL_MAX_REPAIR_ITERATIONS=3
ANTHROPIC_API_KEY=

AGENTEVAL_SANDBOX_IMAGE=agenteval-sandbox:latest
