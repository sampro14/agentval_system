# Copy to .env. All settings use the AGENTEVAL_ prefix (see agenteval/config.py).
AGENTEVAL_DATABASE_URL=postgresql+asyncpg://agenteval:agenteval@localhost:5433/agenteval
AGENTEVAL_REDIS_URL=redis://localhost:6379/0

# anthropic | openai | gemini | deepseek | fake (canned offline demo). Runs can override via the API.
AGENTEVAL_LLM_PROVIDER=anthropic
# Leave unset to use the provider default: claude-opus-5 / gpt-6-sol / gemini-3.8-flash / deepseek-v4-pro
# AGENTEVAL_LLM_MODEL=
AGENTEVAL_MAX_REPAIR_ITERATIONS=3
# Reasoning effort: low | medium | high | xhigh | max. Unset = the provider's default (gemini: low, others: high).
# Higher costs many more tokens and can take over a minute per call; on Gemini, low matched high in tests.
# AGENTEVAL_LLM_EFFORT=

# Only the key for the provider(s) you use is needed.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# AGENTEVAL_DEEPSEEK_BASE_URL=https://api.deepseek.com

AGENTEVAL_SANDBOX_IMAGE=agenteval-sandbox:latest

# Web dashboard: the origin(s) allowed to call the API (JSON list).
# AGENTEVAL_CORS_ORIGINS=["http://localhost:3000"]
# Lets the dashboard's "one agent at a time" page run agents (spends LLM money, starts containers).
AGENTEVAL_ENABLE_DEV_ENDPOINTS=false
